<!--
  Thobe World + H47 Pay test lab in Windows Sandbox (Windows 10/11 Pro, Enterprise or Education).
  1. Create the folder E:\h47-lab on your PC and put in it: this file, setup-lab.ps1 and the H47Pay-<version>-setup.exe.
  2. Double-click this file. The sandbox opens and sets itself up (about 5 minutes the first time).
  Inside the sandbox the folder is C:\h47-lab (the sandbox has only a C: drive).
  Everything in E:\h47-lab is kept when the sandbox closes; the rest of the sandbox is wiped.
  To use another folder, change HostFolder below.
-->
<Configuration>
  <Networking>Enable</Networking>
  <VGpu>Enable</VGpu>
  <MemoryInMB>8192</MemoryInMB>
  <ClipboardRedirection>Enable</ClipboardRedirection>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>E:\h47-lab</HostFolder>
      <SandboxFolder>C:\h47-lab</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>powershell.exe -NoExit -ExecutionPolicy Bypass -File C:\h47-lab\setup-lab.ps1</Command>
  </LogonCommand>
</Configuration>
