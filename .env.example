# Copy to .env (or set these in cPanel « Setup Node.js App » → Environment variables).

# The site's public address (canonical links, sitemap, share cards).
SITE_URL=https://www.example.dz
PORT=8080

# The key you also type in H47 Pay → « Mon site web » → Ajouter un site. Long and secret.
NEWSTORE_SYNC_KEY=
# Signs the « merci » links. Any long random text, different from the key.
APP_SECRET=

# The website dashboard at /admin (home carousel, exclusive launches).
# At least 12 characters; leave empty to keep the dashboard closed.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Where H47 Pay's projection (store.json + photos) and the image cache live. Back it up.
DATA_DIR=./data

# Shop identity (defaults are عالم الثوب's).
SHOP_PHONE=+213659118569
SHOP_PHONE_DISPLAY=0659 11 85 69
SHOP_WHATSAPP=213659118569
SHOP_INSTAGRAM=thobe_world_
SHOP_FACEBOOK=
# Law 18-05: shown in the footer.
SHOP_RC=
SHOP_NIF=

# Ads & analytics. Easier: set them in the dashboard (/admin → Publicité), which
# takes precedence. Leave empty to disable.
META_PIXEL_ID=
TIKTOK_PIXEL_ID=
GA_MEASUREMENT_ID=

# Anti-fake-orders.
ORDER_IP_MAX=6
ORDER_IP_WINDOW_MIN=10
ORDER_DUPLICATE_WINDOW_MIN=30

# Behind cPanel/nginx the client IP comes from the proxy.
TRUST_PROXY=loopback
