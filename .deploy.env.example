# Settings for `npm run deploy`. Copy to .deploy.env (never committed) or set
# them as environment variables. See docs/DEPLOY.md.

# The shop's public address. The deploy waits for <SITE_URL>/health to answer.
SITE_URL=https://www.example.dz

# The Node.js application root, relative to your cPanel home (as typed in
# « Setup Node.js App » → Application root).
APP_DIR=thobe-world

# How to reach it: cpanel (HTTPS API, recommended) or ftp.
DEPLOY_METHOD=cpanel

# --- cPanel (DEPLOY_METHOD=cpanel) -----------------------------------------
# Use port 443 if your host offers it (https://cpanel.<your domain>); a Claude
# cloud session can only reach port 443. Otherwise https://<server>:2083.
CPANEL_URL=https://cpanel.example.dz
CPANEL_USER=
# cPanel → Security → Manage API Tokens → Create. Preferred over the password.
CPANEL_TOKEN=
# Or the account password (does not work with two-factor authentication).
CPANEL_PASSWORD=
# In a Claude cloud session the credential is added by the session's proxy:
# CPANEL_AUTH=proxy

# --- FTP (DEPLOY_METHOD=ftp) ------------------------------------------------
# From a PC or a CI runner only. TLS (FTPS) is on unless FTP_SECURE=false.
# FTP_HOST can be the server's IP address.
FTP_HOST=ftp.example.dz
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
FTP_SECURE=true
# With an IP in FTP_HOST: your server's name, from cPanel → General Information
# → Server Name (or the welcome email), e.g. server123.host.dz.
# FTP_TLS_SERVERNAME=
# Application root as seen from the FTP login folder (defaults to APP_DIR).
# FTP_APP_DIR=thobe-world

# Seconds to wait for the new release to answer before rolling back.
HEALTH_TIMEOUT_S=180
